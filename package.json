{
  "name": "momotalk",
  "productName": "MomoTalk",
  "version": "1.28.2",
  "description": "蔚蓝档案 Momotalk（桃信）桌面版，基于开源 MomoTalk 网页项目封装，署名 ForJiang",
  "main": "main.js",
  "author": "ForJiang",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "selftest": "bash -c 'pkill -f \"MomoTalk.app/Contents/MacOS/MomoTalk\" 2>/dev/null; sleep 1; electron . --self-test'",
    "dist": "electron-builder --mac --arm64",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "io.github.zakosensei.momotalk",
    "productName": "MomoTalk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "ai-extension.js",
      "mmt-locale.js",
      "voice-extension.js",
      "preload.js",
      "www/**/*",
      "build/icon_1024.png",
      "build/forjiang-avatar.jpg",
      "mmt-features.js"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "MomoTalk"
    },
    "extraResources": [
      {
        "from": "build/voice",
        "to": "voice"
      },
      {
        "from": "build/docs",
        "to": "docs"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon_1024.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}